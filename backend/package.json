{
  "name": "@simpleaudience/backend",
  "version": "1.0.0",
  "description": "Headless automation engine for SimpleAudience",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/backend/src/index.js",
    "test": "jest",
    "remote:plan": "tsx src/scripts/run-remote-plan.ts",
    "pipeline:test": "tsx src/scripts/pipeline-smoke.ts",
    "explore:filters": "tsx src/scripts/filter-explorer.ts",
    "explore:analyze": "tsx src/scripts/filter-explorer/analyzer.ts",
    "explore:singles": "npx tsx src/scripts/filter-explorer/runner.ts --singles-only"
  },
  "dependencies": {
    "@simpleaudience/automation": "0.1.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "puppeteer": "^21.6.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "axios": "^1.6.2",
    "ws": "^8.14.2",
    "uuid": "^9.0.1",
    "googleapis": "^128.0.0",
    "sqlite3": "^5.1.6",
    "better-sqlite3": "^9.2.2",
    "zod": "^3.22.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.5",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.7",
    "@types/better-sqlite3": "^7.6.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11"
  },
  "volta": {
    "node": "20.20.0"
  }
}